ruvector.db
*.db-journal

# Agent tooling generated locally (skills, agents, hooks) — machine-specific noise
.claude/*

# Supabase CLI local state
supabase/.temp/
supabase/.branches/

.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/

# `ruflo init --force` overwrites CLAUDE.md and drops this backup beside it.
CLAUDE.md.pre-ruflo

# `.claude/` is ignored above because ruflo generates ~110 files into it. The
# hookify rules are the exception: they encode safety lessons this project paid
# for once already (a destroyed customer booking, an hour of blank magic links)
# and are worthless if they vanish on a fresh clone. The `.local.md` suffix is
# hookify's required naming, not a statement about version control.
!.claude/hookify.*.local.md

.gstack/

# Isolated workspaces for subagent-driven-development plan execution.
.worktrees/

# Design references and /loop iteration screenshots. 63 MB of PNGs, ~95% of
# everything this repository tracked, including byte-identical duplicates from
# the same loop run. They stay on disk and stay useful; they are simply not
# worth carrying in every clone forever. The per-screen `*-log.md` files are
# the part with lasting information, so those are still tracked.
docs/design/**
!docs/design/**/*.md

# `git log` rendered to markdown. Regenerable by definition.
docs/COMMIT_MESSAGE.md
