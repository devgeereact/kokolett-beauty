# ─────────────────────────────────────────────────────────────
# Browser (inlined into the bundle at build time — nothing secret).
# These five VITE_* vars are the only ones src/lib/env.ts reads,
# as static import.meta.env.VITE_* members. Anything else prefixed
# VITE_ is NOT inlined and does not ship, even if it's set.
# ─────────────────────────────────────────────────────────────
VITE_APP_URL="https://www.kokolettbeauty.com"

# Supabase (Auth + PostgreSQL). The anon key is safe for the
# browser because access is gated by Row Level Security.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ImageKit (media CDN + real-time transforms). Only used by the
# dashboard's Services catalogue image picker.
VITE_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"

# Sentry (error + performance monitoring). Region is FIXED at
# project creation and cannot be changed later — use the EU region
# for UK/EU personal data, PII scrubbing on. Only the browser-safe
# DSN belongs in this client bundle.
VITE_SENTRY_DSN="https://your-dsn@sentry.io/project-id"

# ─────────────────────────────────────────────────────────────
# Server only — Supabase Edge Function secrets. NEVER prefix these
# with VITE_ and never reference them from src/. Set with:
#   supabase secrets set KEY=value --project-ref <ref>
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are
# injected by the platform automatically — do not set them here.
# ─────────────────────────────────────────────────────────────

# send-emails: cPanel mail account this app sends transactional email from.
SMTP_HOST="premium17.web-hosting.com"
SMTP_PORT="465"
SMTP_USER="booking@kokolettbeauty.com"
SMTP_PASSWORD="your-mailbox-password"
SMTP_FROM_EMAIL="booking@kokolettbeauty.com"
SMTP_FROM_NAME="Kokolett Beauty UK"

# send-emails: the pg_cron drain job authenticates with this shared secret.
# Function fails closed (refuses every caller, including cron) if unset.
EMAIL_CRON_SECRET="generate-a-long-random-string"

# sync-reviews: the pg_cron review sync authenticates with this shared
# secret. Must be a DIFFERENT value from EMAIL_CRON_SECRET.
REVIEWS_CRON_SECRET="generate-a-different-long-random-string"

# ai-assistant-chat: advisory only — it can propose a booking or a one-off
# email, but never execute either without the owner clicking Confirm.
OPENROUTER_API_KEY="your-openrouter-key"

# sync-reviews: Places API (New) key, server-side only — restrict it by
# API in the Google Cloud console, not by HTTP referrer.
GOOGLE_PLACES_API_KEY="your-google-places-key"

# customer-access, owner-password-reset: base URL used to build links
# sent in email (e.g. the magic-link "manage your booking" URL).
# Falls back to https://www.kokolettbeauty.com if unset.
SITE_URL="https://www.kokolettbeauty.com"

# ai-assistant-chat, customer-access, owner-password-reset,
# render-email-preview: CORS Access-Control-Allow-Origin value.
# Falls back to https://www.kokolettbeauty.com if unset.
ALLOWED_ORIGIN="https://www.kokolettbeauty.com"