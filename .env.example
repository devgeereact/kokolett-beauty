# ─────────────────────────────────────────────────────────────
# App
# Any var read by the browser MUST be prefixed with VITE_.
# ─────────────────────────────────────────────────────────────
VITE_APP_NAME="Kokolett Beauty UK"
VITE_APP_URL="https://www.kokolettbeauty.com"

# ─────────────────────────────────────────────────────────────
# Supabase (Auth + PostgreSQL). The anon key is safe for the
# browser because access is gated by Row Level Security.
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ─────────────────────────────────────────────────────────────
# ImageKit (media CDN + real-time transforms)
# ─────────────────────────────────────────────────────────────
VITE_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"
VITE_IMAGEKIT_PUBLIC_KEY="your-imagekit-public-key"

# ─────────────────────────────────────────────────────────────
# Sentry (error + performance monitoring)
# Region is FIXED at project creation and cannot be changed later —
# pick it up front. EU/DE ingest hosts look like o<org>.ingest.de.sentry.io.
# Apps handling EU/UK personal data: create in the EU region, PII scrubbing on.
# Only the browser-safe DSN belongs in this client bundle.
# ─────────────────────────────────────────────────────────────
VITE_SENTRY_DSN="https://your-dsn@sentry.io/project-id"

# ─────────────────────────────────────────────────────────────
# Inngest
# The static client can only DISPATCH events, so it uses a
# write-only, browser-exposed event key (VITE_ prefix).
# Function code runs on a Supabase Edge Function (never on cPanel) and
# uses the signing key below, which is NEVER shipped to the browser.
# ─────────────────────────────────────────────────────────────
VITE_INNGEST_EVENT_KEY="your-inngest-writeonly-event-key"

# Server-only (used by the Supabase Edge Function that hosts the Inngest
# functions endpoint, NOT by this static bundle). Keep out of the client build.
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="your-inngest-signing-key"

# ─────────────────────────────────────────────────────────────
# Salon operations (browser-safe: display + links only)
# ─────────────────────────────────────────────────────────────
VITE_SALON_TIMEZONE="Europe/London"
VITE_SALON_CURRENCY="GBP"
VITE_SALON_PHONE="++44 7707 906408"
VITE_SALON_EMAIL="booking@kokolettbeauty.com"
VITE_SALON_ADDRESS="Redbourne Dr, London UK. SE28 8RX"
VITE_GOOGLE_REVIEW_URL="https://g.page/r/your-google-review-link/review"

# ─────────────────────────────────────────────────────────────
# Server-only — Supabase Edge Function secrets. NEVER prefix these
# with VITE_ and never reference them from src/. Set with:
#   supabase secrets set KEY=value
# ─────────────────────────────────────────────────────────────
SMTP_HOST="premium17.web-hosting.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM_NAME="Kokolett Beauty UK"
SMTP_FROM_EMAIL="booking@kokolettbeauty.com"

# Magic-link signing. Rotating this invalidates every outstanding link.
MAGIC_LINK_SECRET="generate-a-long-random-string"
MAGIC_LINK_TTL_MINUTES="30"

# AI assistant. Advisory only — output is written to ai_recommendations
# with status 'pending' and never executed without owner approval.
AI_PROVIDER_API_KEY="your-ai-provider-key"
AI_MODEL="your-model-id"

# Service-role key for Edge Functions only. If this ever reaches the browser,
# RLS is bypassed and the entire customer database is readable.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
