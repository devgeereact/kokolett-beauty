# =============================================================
#  cPanel / Apache config for a static Vite SPA (PWA)
#  Upload alongside the contents of /dist into public_html.
# =============================================================

# ---- Force HTTPS + SPA routing --------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect all HTTP traffic to HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Send every non-file, non-directory request to index.html
  # so React Router can resolve client-side routes.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ---- Correct MIME types for PWA assets ------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/json .json
  AddType text/javascript .js .mjs
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

# ---- Compression ----------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript \
    application/javascript application/json image/svg+xml \
    application/manifest+json
</IfModule>

# ---- Caching --------------------------------------------------
<IfModule mod_headers.c>
  # Hashed build assets can be cached forever.
  <FilesMatch "\.(js|mjs|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # NEVER cache the service worker, manifest, or the HTML entrypoint,
  # otherwise users get stuck on stale app versions.
  <FilesMatch "(sw\.js|service-worker\.js|workbox-.*\.js|manifest\.webmanifest|index\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Baseline security headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # ---- HSTS ---------------------------------------------------
  # Two years, subdomains included. Safe here because every domain on this
  # account is already HTTPS-only behind Cloudflare and the rewrite above
  # redirects port 80 anyway — this just removes the one unprotected request at
  # the start of a session.
  #
  # `preload` is deliberately NOT set. Preloading is baked into browsers and is
  # slow and awkward to undo, and it would commit every *.gakinz.com subdomain,
  # including ones this repository knows nothing about.
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"

  # ---- Permissions-Policy -------------------------------------
  # A booking form needs none of these. Denying them means a compromised
  # dependency cannot quietly reach for a camera or a location.
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"

  # ---- CSP, enforcing --------------------------------------------
  # Promoted from Report-Only on 2026-08-20, after the policy was actually
  # exercised rather than assumed. Report-only had never run against real
  # traffic, and it hid one real bug (below).
  #
  # HOW TO ROLL BACK, if something surfaces on a route that was not covered:
  # rename this header to `Content-Security-Policy-Report-Only`. That takes
  # effect on the next request; no rebuild or redeploy of dist/ is needed.
  # Note that a service worker keeps whatever CSP it was installed under until
  # it updates, so an already-open tab may lag a change in either direction.
  #
  # Origins, and why each is here:
  #   supabase.co        REST, Auth, Edge Functions; wss for realtime bookings
  #   ik.imagekit.io     media delivery
  #   *.sentry.io        error + trace ingest (EU region host is o<id>.ingest.de.sentry.io)
  #   fonts.googleapis   the stylesheet; fonts.gstatic serves the font files
  #
  # THE FONT ORIGINS APPEAR TWICE, IN font-src AND IN connect-src, AND BOTH ARE
  # LOAD-BEARING. The service worker runtime-caches Google Fonts
  # (vite.config.ts), and a fetch() from a service worker is governed by
  # connect-src, not font-src. Report-only mode never surfaced this because
  # nobody read the reports; the first enforced load blocked it outright. Remove
  # them from connect-src and the fonts stop being cached, so they refetch on
  # every visit and are missing entirely offline.
  #
  # script-src carries a HASH, not 'unsafe-inline'. index.html has one inline
  # script — the theme bootstrap, which must run before first paint to avoid a
  # flash of the wrong theme. 'unsafe-inline' would have permitted every
  # injected script along with it, which is most of what a CSP is for.
  #
  # THE HASH MUST MATCH THAT SCRIPT EXACTLY. Edit it and the browser refuses to
  # run it: no theme, and any failure in it is silent. CI recomputes the hash
  # from the built index.html and fails if this line disagrees, so the mistake
  # cannot reach production. If CI tells you they differ, take the hash CI
  # prints rather than hand-computing one.
  #
  # style-src keeps 'unsafe-inline': Tailwind injects styles at runtime, and the
  # 12 components using style={{}} for genuinely dynamic geometry emit style
  # attributes. Removing it needs those reworked first, and buys much less than
  # the script-src hash already does.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-2sS670w3y+a111IgzoyiIyJ5ha3SL6VCrwVNnqtH1oM='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://ik.imagekit.io; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://ik.imagekit.io https://fonts.googleapis.com https://fonts.gstatic.com https://*.sentry.io https://*.ingest.sentry.io https://*.ingest.de.sentry.io; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>

# ---- Pretty error handling ------------------------------------
ErrorDocument 404 /index.html
