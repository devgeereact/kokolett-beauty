# =============================================================
#  cPanel / Apache config for a static Vite SPA (PWA)
#  Upload alongside the contents of /dist into public_html.
# =============================================================

# ---- Force HTTPS + SPA routing --------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect all HTTP traffic to HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Send every non-file, non-directory request to index.html
  # so React Router can resolve client-side routes.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ---- Correct MIME types for PWA assets ------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/json .json
  AddType text/javascript .js .mjs
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

# ---- Compression ----------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript \
    application/javascript application/json image/svg+xml \
    application/manifest+json
</IfModule>

# ---- Caching --------------------------------------------------
<IfModule mod_headers.c>
  # Hashed build assets can be cached forever.
  <FilesMatch "\.(js|mjs|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # NEVER cache the service worker, manifest, or the HTML entrypoint,
  # otherwise users get stuck on stale app versions.
  <FilesMatch "(sw\.js|service-worker\.js|workbox-.*\.js|manifest\.webmanifest|index\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Baseline security headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # ---- HSTS ---------------------------------------------------
  # Two years, subdomains included. Safe here because every domain on this
  # account is already HTTPS-only behind Cloudflare and the rewrite above
  # redirects port 80 anyway — this just removes the one unprotected request at
  # the start of a session.
  #
  # `preload` is deliberately NOT set. Preloading is baked into browsers and is
  # slow and awkward to undo, and it would commit every *.gakinz.com subdomain,
  # including ones this repository knows nothing about.
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"

  # ---- Permissions-Policy -------------------------------------
  # A booking form needs none of these. Denying them means a compromised
  # dependency cannot quietly reach for a camera or a location.
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"

  # ---- CSP, in Report-Only first ------------------------------
  # REPORT-ONLY ON PURPOSE. This policy has never run against real traffic, and
  # an enforced CSP that is even slightly wrong takes the site down hard — a
  # blocked script is a blank page, not a degraded one. Run it in report-only,
  # watch the console and Sentry for violations across the booking flow, the
  # magic-link flow and the dashboard, and only then rename this header to
  # `Content-Security-Policy`.
  #
  # Origins, and why each is here:
  #   supabase.co        REST, Auth, Edge Functions; wss for realtime bookings
  #   ik.imagekit.io     media delivery
  #   *.sentry.io        error + trace ingest (EU region host is o<id>.ingest.de.sentry.io)
  #   inn.gs             Inngest event dispatch (write-only key)
  #   fonts.googleapis   the stylesheet; fonts.gstatic serves the font files
  #
  # 'unsafe-inline' for style-src is required by the inline theme script's
  # style writes and by Tailwind's runtime style injection. script-src does NOT
  # carry it — but the theme bootstrap in index.html is an inline <script>, so
  # 'unsafe-inline' there is what report-only mode is meant to reveal. Prefer a
  # hash over blanket inline when this is promoted to enforcing.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://ik.imagekit.io; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://ik.imagekit.io https://*.sentry.io https://*.ingest.sentry.io https://*.ingest.de.sentry.io https://inn.gs; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>

# ---- Pretty error handling ------------------------------------
ErrorDocument 404 /index.html
